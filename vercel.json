{
  "version": 2,
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**": {
      "includeFiles": "node_modules/@electric-sql/pglite/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
